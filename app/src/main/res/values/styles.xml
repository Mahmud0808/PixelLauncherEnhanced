<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="PrefsThemeToolbar" parent="PreferenceThemeOverlay.v14.Material">
        <item name="android:layout">@layout/fragment_preference_container</item>
        <item name="alertDialogTheme">@style/MaterialComponents.MaterialAlertDialog</item>
        <item name="android:alertDialogTheme">@style/MaterialComponents.MaterialAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/MaterialComponents.MaterialAlertDialog</item>
    </style>

    <style name="PrefsThemeCollapsingToolbar" parent="PreferenceThemeOverlay.v14.Material">
        <item name="android:layout">@layout/fragment_preference_container_home</item>
        <item name="alertDialogTheme">@style/MaterialComponents.MaterialAlertDialog</item>
        <item name="android:alertDialogTheme">@style/MaterialComponents.MaterialAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/MaterialComponents.MaterialAlertDialog</item>
    </style>

    <style name="PrefsThemeNoToolbar" parent="PreferenceThemeOverlay.v14.Material">
        <item name="android:layout">@layout/fragment_preference_container_no_toolbar</item>
        <item name="alertDialogTheme">@style/MaterialComponents.MaterialAlertDialog</item>
        <item name="android:alertDialogTheme">@style/MaterialComponents.MaterialAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/MaterialComponents.MaterialAlertDialog</item>
    </style>

    <style name="Widget.MaterialButton" parent="Widget.Material3Expressive.Button">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">40dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingEnd">40dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.MaterialButton.Red" parent="Widget.MaterialButton">
        <item name="backgroundTint">?attr/colorError</item>
        <item name="android:textColor">?attr/colorOnError</item>
        <item name="rippleColor">@color/color_material_ripple_no_tint</item>
    </style>

    <style name="PopupMenu.Overflow" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:popupElevation">6dp</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>

    <style name="PopupMenu.Popup" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:popupElevation">6dp</item>
    </style>

    <style name="PopupMenu" parent="@android:style/Widget.PopupMenu">
        <item name="android:popupBackground">?attr/colorSurfaceVariant</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Preference.TitleText" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="Preference.SummaryText" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="Toolbar.TitleText" parent="TextAppearance.Material3.TitleLarge" />

    <style name="Toolbar.TitleText.Collapsed">
        <item name="android:textSize">22sp</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_color_primary</item>
    </style>

    <style name="Toolbar.TitleText.Expanded" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">40sp</item>
        <item name="android:textColor">@color/text_color_primary</item>
    </style>

    <style name="MaterialAlertDialog.Title.TextAppearance" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="MaterialAlertDialog.Body.TextAppearance" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="MaterialAlertDialog.Title.Text" parent="MaterialAlertDialog.Material3Expressive.Title.Text">
        <item name="android:textAppearance">@style/MaterialAlertDialog.Title.TextAppearance</item>
    </style>

    <style name="MaterialAlertDialog.Body.Text" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">@style/MaterialAlertDialog.Body.TextAppearance</item>
    </style>

    <style name="MaterialAlertDialog.Button.Positive" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <style name="MaterialAlertDialog.Button.Text" parent="Widget.Material3Expressive.Button.TextButton.Dialog" />

    <style name="MaterialAlertDialog.Surface" parent="MaterialAlertDialog.Material3Expressive">
        <item name="shapeAppearance">@style/ShapeAppearance.Dialog</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
    </style>

    <style name="ShapeAppearance.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">32dp</item>
    </style>

    <style name="MaterialAlertDialog.Title.Text.Centered" parent="MaterialAlertDialog.Material3Expressive.Title.Text.CenterStacked">
        <item name="android:textAppearance">@style/MaterialAlertDialog.Title.TextAppearance</item>
    </style>

    <style name="MaterialAlertDialog.Body.Text.Centered" parent="MaterialAlertDialog.Material3.Body.Text.CenterStacked">
        <item name="android:textAppearance">@style/MaterialAlertDialog.Body.TextAppearance</item>
    </style>

    <style name="MaterialComponents.MaterialAlertDialog.Centered" parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog.Centered">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Surface</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Title.Text.Centered</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.Body.Text.Centered</item>
        <item name="buttonBarPositiveButtonStyle">@style/MaterialAlertDialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/MaterialAlertDialog.Button.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/MaterialAlertDialog.Button.Text</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

    <style name="MaterialComponents.MaterialAlertDialog" parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Surface</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Title.Text</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.Body.Text</item>
        <item name="buttonBarPositiveButtonStyle">@style/MaterialAlertDialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/MaterialAlertDialog.Button.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/MaterialAlertDialog.Button.Text</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

</resources>