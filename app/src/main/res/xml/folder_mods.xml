<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.drdisagree.pixellauncherenhanced.ui.preferences.PageHeaderPreference
        android:key="page_header_folders"
        app:iconSpaceReserved="false" />

    <com.drdisagree.pixellauncherenhanced.ui.preferences.PreferenceCategory
        android:key="xposed_home_screen_folders"
        android:icon="@drawable/ic_section_layout"
        android:title="@string/section_layout_title"
        app:iconSpaceReserved="false">

        <com.drdisagree.pixellauncherenhanced.ui.preferences.SliderPreference
            android:key="xposed_foldergridcolumns"
            android:title="@string/folder_columns_title"
            app:defaultValue="0"
            app:hideValueOnDefault="true"
            app:iconSpaceReserved="false"
            app:maxVal="10"
            app:minVal="0"
            app:showDefaultIndicator="true"
            app:showResetButton="true"
            app:tickInterval="1" />

        <com.drdisagree.pixellauncherenhanced.ui.preferences.SliderPreference
            android:key="xposed_foldergridrows"
            android:title="@string/folder_rows_title"
            app:defaultValue="0"
            app:hideValueOnDefault="true"
            app:iconSpaceReserved="false"
            app:maxVal="10"
            app:minVal="0"
            app:showDefaultIndicator="true"
            app:showResetButton="true"
            app:tickInterval="1" />

    </com.drdisagree.pixellauncherenhanced.ui.preferences.PreferenceCategory>

    <com.drdisagree.pixellauncherenhanced.ui.preferences.PreferenceCategory
        android:key="xposed_folder_general_section"
        android:icon="@drawable/ic_section_general"
        android:title="@string/section_general_title"
        app:iconSpaceReserved="false">

        <com.drdisagree.pixellauncherenhanced.ui.preferences.SwitchPreference
            android:defaultValue="false"
            android:key="xposed_foldertapfirstapp"
            android:summary="@string/folder_tap_first_app_desc"
            android:title="@string/folder_tap_first_app_title"
            app:iconSpaceReserved="false" />

        <com.drdisagree.pixellauncherenhanced.ui.preferences.SwitchPreference
            android:defaultValue="false"
            android:key="xposed_foldercover"
            android:summary="@string/folder_cover_desc"
            android:title="@string/folder_cover_title"
            app:iconSpaceReserved="false" />

    </com.drdisagree.pixellauncherenhanced.ui.preferences.PreferenceCategory>

    <com.drdisagree.pixellauncherenhanced.ui.preferences.PreferenceCategory
        android:key="xposed_folder_background_section"
        android:icon="@drawable/ic_section_background"
        android:title="@string/section_background_title"
        app:iconSpaceReserved="false">

        <com.drdisagree.pixellauncherenhanced.ui.preferences.ListPreference
            android:defaultValue="off"
            android:dialogTitle="@string/folder_background_title"
            android:entries="@array/panel_background_str"
            android:entryValues="@array/panel_background_value"
            android:key="xposed_folderbackground"
            android:summary="@string/panel_background_desc"
            app:summaryWarning="true"
            android:title="@string/folder_background_title"
            app:iconSpaceReserved="false" />

        <com.drdisagree.pixellauncherenhanced.ui.preferences.PreferenceMenu
            android:key="glass_editor_link_folder"
            android:summary="@string/glass_editor_link_desc"
            android:title="@string/glass_editor_link_title"
            app:fragment="com.drdisagree.pixellauncherenhanced.ui.fragments.GlassEditor"
            app:iconSpaceReserved="false">
            <extra
                android:name="glass_target"
                android:value="folder" />
        </com.drdisagree.pixellauncherenhanced.ui.preferences.PreferenceMenu>

    </com.drdisagree.pixellauncherenhanced.ui.preferences.PreferenceCategory>

</PreferenceScreen>
