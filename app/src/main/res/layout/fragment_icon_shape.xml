<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    tools:context=".ui.fragments.IconShapeEditor">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ui_container_margin_side"
            android:paddingTop="20dp"
            android:paddingBottom="112dp">

            <com.drdisagree.pixellauncherenhanced.ui.widgets.IconShapePreviewView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="176dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/previewSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="28dp"
                android:text="@string/icon_shape_style"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/ui_container_margin_side_negative"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tiles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/sliderCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/customCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/icon_shape_draw_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/undo"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/icon_shape_undo"
                            app:iconTint="@color/shape_history_icon"
                            app:icon="@drawable/ic_undo" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/redo"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/icon_shape_redo"
                            app:iconTint="@color/shape_history_icon"
                            app:icon="@drawable/ic_redo" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/clearDrawing"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/icon_shape_clear"
                            app:iconTint="@color/shape_history_icon"
                            app:icon="@drawable/ic_delete" />

                    </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/drawHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/icon_shape_draw_hint"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/tools"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleLine="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/toolSelect"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/icon_shape_tool_select"
                                android:textColor="@color/editor_toggle_content"
                                app:checkedIconTint="@color/editor_toggle_content"
                                app:chipBackgroundColor="@color/editor_toggle_background"
                                app:chipStrokeWidth="0dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/toolOutline"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/icon_shape_tool_draw"
                                android:textColor="@color/editor_toggle_content"
                                app:checkedIconTint="@color/editor_toggle_content"
                                app:chipBackgroundColor="@color/editor_toggle_background"
                                app:chipStrokeWidth="0dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/toolCircle"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/icon_shape_tool_circle"
                                android:textColor="@color/editor_toggle_content"
                                app:checkedIconTint="@color/editor_toggle_content"
                                app:chipBackgroundColor="@color/editor_toggle_background"
                                app:chipStrokeWidth="0dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/toolSquare"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/icon_shape_tool_square"
                                android:textColor="@color/editor_toggle_content"
                                app:checkedIconTint="@color/editor_toggle_content"
                                app:chipBackgroundColor="@color/editor_toggle_background"
                                app:chipStrokeWidth="0dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/toolRing"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/icon_shape_tool_ring"
                                android:textColor="@color/editor_toggle_content"
                                app:checkedIconTint="@color/editor_toggle_content"
                                app:chipBackgroundColor="@color/editor_toggle_background"
                                app:chipStrokeWidth="0dp" />

                        </com.google.android.material.chip.ChipGroup>

                    </HorizontalScrollView>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/brushMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/modeAdd"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/icon_shape_add"
                            android:textColor="@color/editor_toggle_content"
                            app:checkedIconVisible="false"
                            app:chipBackgroundColor="@color/editor_toggle_background"
                            app:chipIcon="@drawable/ic_add"
                            app:chipIconTint="@color/editor_toggle_content"
                            app:chipIconVisible="true"
                            app:chipStrokeWidth="0dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/modeCut"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/icon_shape_cut"
                            android:textColor="@color/editor_toggle_content"
                            app:checkedIconVisible="false"
                            app:chipBackgroundColor="@color/editor_toggle_background"
                            app:chipIcon="@drawable/ic_remove"
                            app:chipIconTint="@color/editor_toggle_content"
                            app:chipIconVisible="true"
                            app:chipStrokeWidth="0dp" />

                    </com.google.android.material.chip.ChipGroup>

                    <com.drdisagree.pixellauncherenhanced.ui.widgets.ShapeDrawView
                        android:id="@+id/drawPad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/symmetry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleLine="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/symmetryOff"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/icon_shape_symmetry_off"
                                android:textColor="@color/editor_toggle_content"
                                app:checkedIconTint="@color/editor_toggle_content"
                                app:chipBackgroundColor="@color/editor_toggle_background"
                                app:chipStrokeWidth="0dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/symmetryMirror"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/icon_shape_symmetry_mirror"
                                android:textColor="@color/editor_toggle_content"
                                app:checkedIconTint="@color/editor_toggle_content"
                                app:chipBackgroundColor="@color/editor_toggle_background"
                                app:chipStrokeWidth="0dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/symmetryQuad"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/icon_shape_symmetry_quad"
                                android:textColor="@color/editor_toggle_content"
                                app:checkedIconTint="@color/editor_toggle_content"
                                app:chipBackgroundColor="@color/editor_toggle_background"
                                app:chipStrokeWidth="0dp" />

                        </com.google.android.material.chip.ChipGroup>

                    </HorizontalScrollView>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/drawStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorError"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/apply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:text="@string/icon_shape_apply"
        android:visibility="gone"
        app:icon="@drawable/ic_check" />

    <include
        android:id="@+id/header"
        layout="@layout/view_header_expandable" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
